---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
import config from "@/config";

const about = await getEntry("pages", "about");
if (!about) {
  throw new Error("About page not found");
}

const { Content } = await render(about);

// ✅ Safely extract the src string if ogImage is an object
let ogImageUrl = undefined;
if (typeof about.data.ogImage === "string") {
  ogImageUrl = about.data.ogImage;
} else if (about.data.ogImage) {
  ogImageUrl = (about.data.ogImage as any).src;
}
---

<Layout title={`About | ${config.site.title}`} ogImage={ogImageUrl}>
  <Header />
  <Main pageTitle="About" pageDesc={about.data.description}>
    <Content />
  </Main>
  <Footer />
</Layout>
